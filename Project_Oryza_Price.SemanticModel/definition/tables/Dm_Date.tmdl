	partition Dm_Date = calculated
		mode: import
		source =
				
				VAR _MinDate = MIN('Fct_Oryza Price'[HeaderDate])
				VAR _MaxDate = MAX('Fct_Oryza Price'[HeaderDate])
				VAR startYear = IF( ISBLANK(_MinDate), 2020, YEAR(_MinDate) )
				VAR endYear =   IF( ISBLANK(_MaxDate), DATE(2026, 12, 31), _MaxDate )
				RETURN
				ADDCOLUMNS (
				    CALENDAR(
				                DATE(startYear,1,1),
				                endYear
				            ),
				    "Year", YEAR ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm" ),
				    "MonthID", MONTH ( [Date] ),
				    "MonthYear", FORMAT ( [Date], "mmm-yy" ),
				    "MonthYearID", INT(FORMAT ( [Date], "yyyymm" )),
				    "QuarterYear", "Q" & FORMAT ( [Date], "q yyyy" ),
				    "QuarterYearID", INT(FORMAT ( [Date], "yyyyq" )),
				    "DayName", FORMAT( [DATE], "ddd"),
				    "DayID", WEEKDAY([Date],2)
				)

	annotation PBI_Id = e921826c472a4d25a07fc6ad5eeea315

