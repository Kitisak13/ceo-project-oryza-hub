table DAX
	lineageTag: c692f9b5-cef0-4342-a934-eed1640c344d

	measure 'Average Price' = AVERAGE('Fct_Oryza Price'[Avg_Price])
		lineageTag: 2a807a33-1446-4f68-9e3f-f9449d060b5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price Last Day' = ```
			CALCULATE( [Average Price] ,
			                                LASTDATE( 'Fct_Oryza Price'[HeaderDate] ) ) 
			```
		lineageTag: 83517bca-04ea-470d-b1cf-cbde38fb8f99

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price Previous Day' =
			
			
			IF( NOT ISEMPTY('Fct_Oryza Price'),
			    VAR _Maxdate = MAX(Dm_Date[Date])
			    VAR _PreviousdatePrice = CALCULATE( MAX( 'Fct_Oryza Price'[HeaderDate] ),
			                                        Dm_Date[Date] < _Maxdate )
			    VAR _Result = CALCULATE( [Average Price] ,
			                             Dm_Date[Date] = _PreviousdatePrice )
			
			    RETURN _Result )
			
			/* CALCULATE( [Average Price] ,
			   DATEADD( LASTDATE( 'Fct_Oryza Price'[HeaderDate] ), -1 , DAY ) ) */
		lineageTag: 68108a1e-0f9f-4df8-af22-34c3a1de2287

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price Last Month' = ```
			
			VAR _startyear = YEAR( LASTDATE( Dm_Date[Date] ) ) 
			VAR _startmonth = MONTH( LASTDATE( Dm_Date[Date] ) )
			VAR _lastdate = LASTDATE( Dm_Date[Date] )
			VAR _result =
			                CALCULATE([Average Price] , 
			                          ALL(Dm_Date[Date]),
			                          DATESBETWEEN( Dm_Date[Date] , 
			                                        DATE( _startyear, _startmonth, 1), 
			                                        _lastdate ) )
			RETURN _result
			```
		lineageTag: 08b106b3-b1e8-41ff-a71e-99a907940288

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price Last Month LY' = ```
			
			VAR _startyear = YEAR( LASTDATE( Dm_Date[Date] ) ) - 1 
			VAR _startmonth = MONTH( LASTDATE( Dm_Date[Date] ) )
			VAR _lastdate = 31
			VAR _result =
			                CALCULATE([Average Price] , 
			                          ALL(Dm_Date[Date]),
			                          DATESBETWEEN( Dm_Date[Date] , 
			                                        DATE( _startyear, _startmonth, 1), 
			                                        DATE( _startyear, _startmonth, 31) ) ) 
			RETURN _result
			```
		lineageTag: 9d665eb9-17f1-441f-a4ce-c0fd48f4ae11

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price YoY' = CALCULATE( [Average Price] , SAMEPERIODLASTYEAR(Dm_Date[Date] ) )
		lineageTag: 97ca54ce-ac42-49b1-9785-65b8ff3d4cd1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price YoY%' =
			
			VAR _YOY = DIVIDE( [Average Price] , [Avg Price YoY] , 0 ) - 1
			VAR _result = IF( NOT( ISBLANK( [Avg Price YoY]) || [Average Price] <> 0) , _YOY )
			RETURN _result
		formatString: +0.0% ; - 0.0%
		lineageTag: f8c31ad4-55f7-412e-8071-3c42be4fc671

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Avg Price MoM' = ```
			CALCULATE( [Average Price] , 
			                           DATEADD(Dm_Date[Date], -1 , MONTH ) )
			```
		lineageTag: 186507dc-017b-43f0-8754-274e5f297ad1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price MoM%' =
			
			VAR _MoM = DIVIDE( [Average Price] , [Avg Price MoM] , 0 ) - 1
			VAR _result = IF( NOT( ISBLANK( [Avg Price MoM]) || [Average Price] <> 0 ) , _MoM )
			RETURN _result
		formatString: +0.0% ; - 0.0%
		lineageTag: dba9d584-0c67-44f6-9524-6b560a4a4b40

