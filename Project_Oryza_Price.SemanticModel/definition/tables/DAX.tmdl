		lineageTag: f193a8be-592b-4235-082b-1f93a8be592b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fragrant Rice Premium %' =
			VAR _Fragrant = CALCULATE([Average Price], Dm_Category[Category Code] = "C000001")
			VAR _WhiteHigh = CALCULATE([Average Price], Dm_Category[Category Code] = "C000004")
			RETURN DIVIDE(_Fragrant - _WhiteHigh, _WhiteHigh, 0)
		formatString: +0.00% ; -0.00%
		displayFolder: 05. Benchmarks & Price Spreads
		lineageTag: f4533170-2b1a-4200-082c-45331702b1aa

	measure 'MA 90D Signal Flag' =
			VAR _Avg = [Average Price]
			VAR _MA90 = [Avg Price 90D MA]
			RETURN IF(ISBLANK(_Avg) || ISBLANK(_MA90), "No Data", IF(_Avg >= _MA90, "Bullish Trend (+)", "Bearish Trend (-)"))
		displayFolder: 03. Trend & Moving Averages
		lineageTag: f893a7c9-64d6-4576-b5c5-893a7c964d6c

	measure 'Gap to 52W High %' =
			VAR _Avg = [Average Price]
			VAR _High = [52 Week H]
			RETURN DIVIDE(_Avg - _High, _High, 0)
		formatString: 0.00%
		displayFolder: 03. Trend & Moving Averages
		lineageTag: f89eab91-dea4-4933-840d-89eab91dea48

	measure 'Gap to 52W Low %' =
			VAR _Avg = [Average Price]
			VAR _Low = [52 Week L]
			RETURN DIVIDE(_Avg - _Low, _Low, 0)
		formatString: 0.00%
		displayFolder: 03. Trend & Moving Averages
		lineageTag: fa23b6ab-1752-49d8-1001-a23b6ab17529

	measure 'Growth Band Color' =
			
			VAR Wek = [Avg Price WoW%]
			RETURN
			SWITCH(
			    TRUE(),
			    Wek >= 0.10, "#006400",
			    Wek >= 0.05, "#008000",
			    Wek > 0, "#90EE90",
			    Wek = 0, "#808080",
			    Wek >= -0.05, "#FFA500",
			    "#FF0000"
			)
		displayFolder: 10. Text
		lineageTag: 5a9a3bb1-36e7-436e-b580-4447af6de00a

	measure 'Avg Price WoW% Color' =
			
			VAR WoW = [Avg Price WoW%]
			RETURN
			    SWITCH(
			        TRUE(),
			        WoW > 0, "#089BAB",    -- Green
			        WoW < 0, "#FF0000",    -- Red
			        "#000000"              -- Black (0 หรือ BLANK)
			    )
		displayFolder: 10. Text
		lineageTag: 8f6a33f6-11a1-48c5-a5e5-92a34e12993e

	measure 'Avg Price WoW% test' =
			
			VAR WoW = [Avg Price WoW%]
			RETURN
			    SWITCH(
			        TRUE(),
			        WoW > 0, "▲ " & FORMAT(WoW,"0.0%"),
			        WoW < 0, "▼ " & FORMAT(WoW,"0.0%"),
			        "► " & FORMAT(WoW,"0.0%")
			    )
		displayFolder: 10. Text
		lineageTag: b8364405-e0ab-4065-beca-22dccbfc4824

	measure 'Title Rice Category' =
			VAR _SelectedCategory = SELECTEDVALUE( Dm_Category[Category Eng] )
			VAR _CategoryCount = COUNTROWS( VALUES( Dm_Category[Category Eng] ) )
			VAR _TotalCategories = COUNTROWS( ALL( Dm_Category[Category Eng] ) )
			RETURN
			    IF(
			        NOT ISBLANK( _SelectedCategory ),
			        "Oryza Global Rice Price : " & _SelectedCategory,
			        IF(
			            _CategoryCount < _TotalCategories && _CategoryCount > 1,
			            "Oryza Global Rice Price : " & CONCATENATEX( VALUES( Dm_Category[Category Eng] ), Dm_Category[Category Eng], ", " ),
			            "Oryza Global Rice Price : All Categories"
			        )
			    )
		displayFolder: 10. Text
		lineageTag: a1c43b92-4f81-49ea-bc91-23da567a1001

	measure 'Title Rice Category & Product' =
			VAR _Category = SELECTEDVALUE( Dm_Category[Category Eng], "All Categories" )
			VAR _Product = SELECTEDVALUE( 'Dm_Product Name'[Product Name] )
			RETURN
			    IF(
			        NOT ISBLANK( _Product ),
			        "Oryza Global Rice Price : " & _Category & " > " & _Product,
			        "Oryza Global Rice Price : " & _Category
			    )
		displayFolder: 10. Text
		lineageTag: a1c43b92-4f81-49ea-bc91-23da567a1002

	measure 'Subtitle Latest Date & Price' =
			VAR _LastDate = CALCULATE( MAX( 'Fct_Oryza Price'[HeaderDate] ), ALLSELECTED('Fct_Oryza Price') )
			VAR _AvgPrice = [Avg Price Last Day]
			VAR _WoW = [Avg Price WoW%]
			VAR _Direction = IF( _WoW > 0, "▲ +" & FORMAT( _WoW, "0.0%" ), IF( _WoW < 0, "▼ " & FORMAT( _WoW, "0.0%" ), "► 0.0%" ) )
			RETURN
			    "Latest As Of: " & FORMAT( _LastDate, "dd-mmm-yyyy" ) & 
			    " | Price: $" & FORMAT( _AvgPrice, "#,##0.00" ) & "/MT (" & _Direction & " WoW)"
		displayFolder: 10. Text
		lineageTag: a1c43b92-4f81-49ea-bc91-23da567a1003

	measure 'Market Movement Summary Text' =
			VAR _WoW = [Avg Price WoW%]
			VAR _MoM = [Avg Price MoM%]
			VAR _Status = 
			    SWITCH(
			        TRUE(),
			        _WoW > 0.02 && _MoM > 0.05, "Strong Bullish (Accelerating Upward)",
			        _WoW > 0, "Mild Bullish (Upward Momentum)",
			        _WoW < -0.02 && _MoM < -0.05, "Strong Bearish (Sharp Correction)",
			        _WoW < 0, "Mild Bearish (Downward Pressure)",
			        "Stable / Neutral"
			    )
			RETURN
			    "Market Sentiment: " & _Status & " (WoW: " & FORMAT( _WoW, "+0.0%;-0.0%;0.0%" ) & " | MoM: " & FORMAT( _MoM, "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: 10. Text
		lineageTag: a1c43b92-4f81-49ea-bc91-23da567a1004

	measure '52W Range Summary Text' =
			VAR _Low = [52 Week L]
			VAR _High = [52 Week H]
			VAR _Current = [Avg Price Last Day]
			RETURN
			    "52W Range: $" & FORMAT( _Low, "#,##0" ) & " - $" & FORMAT( _High, "#,##0" ) & " (Current at " & FORMAT( DIVIDE( _Current - _Low, _High - _Low, 0 ), "0.0%" ) & " of band)"
		displayFolder: 10. Text
		lineageTag: a1c43b92-4f81-49ea-bc91-23da567a1005

	measure 'Top Moving SKU Text' =
			VAR _TopSKU = TOPN( 1, VALUES( 'Dm_Product Name'[Product Name] ), ABS( [Avg Price WoW%] ), DESC )
			VAR _SKUName = CALCULATE( SELECTEDVALUE( 'Dm_Product Name'[Product Name] ), _TopSKU )
			VAR _SKUWoW = CALCULATE( [Avg Price WoW%], _TopSKU )
			RETURN
			    IF(
			        NOT ISBLANK( _SKUName ),
			        "Top Mover: " & _SKUName & " (" & FORMAT( _SKUWoW, "+0.0%;-0.0%;0.0%" ) & " WoW)",
			        "No SKU data available"
			    )
		displayFolder: 10. Text
		lineageTag: a1c43b92-4f81-49ea-bc91-23da567a1006


