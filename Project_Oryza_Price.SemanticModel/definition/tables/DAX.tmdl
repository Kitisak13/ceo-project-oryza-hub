	measure 'Rolling 30D Volatility %' =
			VAR _StdDev = CALCULATE(STDEV.P('Fct_Oryza Price'[Avg_Price]), DATESINPERIOD('Dm_Date'[Date], MAX('Dm_Date'[Date]), -30, DAY))
