		lineageTag: 186507dc-017b-43f0-8754-274e5f297ad1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price MoM%' =
			VAR _MoM = DIVIDE( [Average Price] - [Avg Price MoM] , [Avg Price MoM] , 0 )
			RETURN _MoM
		formatString: +0.0% ; - 0.0%
