	measure 'Avg Price This Year' = ```
			VAR _ThisYear = DATESBETWEEN( Dm_Date[Date] , 
			                              DATE(YEAR(LASTDATE(Dm_Date[Date])), 1 , 1 ) ,
			                              LASTDATE( Dm_Date[Date] ) )
			VAR Result = CALCULATE( [Average Price], _ThisYear )
			RETURN Result 
			```
		displayFolder: 02. Time Intelligence
		lineageTag: a581e59b-8466-4019-bc6f-88312b111dc2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Price Last Year' = ```
			VAR _LastYear = DATESBETWEEN(Dm_Date[Date] , 
			                             DATE(YEAR(LASTDATE(Dm_Date[Date]))-1, 1 , 1 ) ,
			                             DATE(YEAR(LASTDATE(Dm_Date[Date]))-1, 12 , 31 ) )
			VAR Result = CALCULATE( [Average Price], _LastYear )
			RETURN Result 
			```
		displayFolder: 02. Time Intelligence
		lineageTag: cee274c2-2b4e-45eb-af26-556dc9fb09e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure △Day =
			VAR _Daychange = [Avg Price Last Day]- [Avg Price Previous Day]
			VAR _result = IF([Avg Price Last Day] <> 0 && [Avg Price Previous Day] <> 0 , _Daychange)
			RETURN _result
		formatString: +0.00 ; -0.00
		displayFolder: 07. UI & System Helpers
		lineageTag: 43c6d110-d441-4733-8b2b-af7a73882643

		annotation PBI_FormatHint = {"isCustom":true}

	measure %△Month = ```
			VAR _Monthchange = DIVIDE([Avg Price Last Month],[Avg Price Last Month LY],0) - 1 
			VAR _result = IF([Avg Price Last Month] <> 0 && [Avg Price Last Month LY] <> 0 , _Monthchange)
			RETURN _result
			```
		formatString: +0.00% ; -0.00%
		displayFolder: 07. UI & System Helpers
		lineageTag: bfed130e-864b-4af2-ba42-0385d663953d

		annotation PBI_FormatHint = {"isCustom":true}

	measure %△Year = ```
			VAR _Yearchange = DIVIDE([Avg Price This Year] , [Avg Price Last Year] , 0 ) -1 
			VAR _result = IF([Avg Price This Year] <> 0 && [Avg Price Last Year] <> 0 , _Yearchange)
			RETURN _result
			```
		formatString: +0.00% ; -0.00%
		displayFolder: 07. UI & System Helpers
		lineageTag: 02da03a2-23ae-4223-baac-620ee2a4da27

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Text_color Day' = IF([△Day] > 0 , "Blue", IF( [△Day] < 0 , "Red" , "Black"))
		displayFolder: 07. UI & System Helpers
		lineageTag: 412af95c-a797-40e1-ad5b-f13bdd317fc2

