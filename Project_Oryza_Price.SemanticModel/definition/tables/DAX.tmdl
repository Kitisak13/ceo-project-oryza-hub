	measure 'Benchmark Price (India)' = CALCULATE( [Average Price], 'Fct_Oryza Price'[Country Name] = "India" )
		displayFolder: 05. Benchmarks & Price Spreads
		lineageTag: a426bab4-eece-4d2e-a823-bd9fca52f433

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Spread vs India Benchmark' =
			VAR _CurrentPrice = [Average Price]
			VAR _IndiaPrice = [Benchmark Price (India)]
			VAR _Result = IF( NOT( ISBLANK(_CurrentPrice) || ISBLANK(_IndiaPrice) ), _CurrentPrice - _IndiaPrice )
			RETURN _Result
		displayFolder: 05. Benchmarks & Price Spreads
		lineageTag: a8a4365a-5dfc-470f-97ec-46da8deb1b77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Thai vs Viet Price Spread' =
			VAR _ThaiPrice = CALCULATE( [Average Price], 'Fct_Oryza Price'[Country Name] = "Thailand" )
			VAR _VietPrice = CALCULATE( [Average Price], 'Fct_Oryza Price'[Country Name] = "Vietnam" )
			VAR _Result = IF( NOT( ISBLANK(_ThaiPrice) || ISBLANK(_VietPrice) ), _ThaiPrice - _VietPrice )
			RETURN _Result
		displayFolder: 05. Benchmarks & Price Spreads
		lineageTag: 409dd912-a332-4ea5-81f0-1ea187ab0223

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Country Price Rank' =
			IF(
			    HASONEVALUE( 'Fct_Oryza Price'[Country Name] ),
			    RANKX(
			        ALL( 'Fct_Oryza Price'[Country Name] ),
			        [Average Price],
			        ,
			        DESC,
			        Dense
			    )
			)
		displayFolder: 06. Rankings
		lineageTag: 7bc9783a-089b-4fc4-99b6-0b36dcd1b6b5

	measure 'Avg Price WoW%' =
			VAR _LastDate = CALCULATE( MAX( 'Fct_Oryza Price'[HeaderDate] ), ALL( Dm_Date ) )
			VAR _CurrentPrice = [Avg Price Last Day]
			VAR _TargetDate = _LastDate - 7
			VAR _PreviousWeekPrice =
				CALCULATE(
					[Average Price],
					ALL( Dm_Date ),
					DATESBETWEEN( Dm_Date[Date], _TargetDate - 3, _TargetDate )
				)
			VAR _Result = IF( NOT ISBLANK(_CurrentPrice) && NOT ISBLANK(_PreviousWeekPrice) && _PreviousWeekPrice <> 0, DIVIDE(_CurrentPrice - _PreviousWeekPrice, _PreviousWeekPrice, 0) )
			RETURN _Result
		formatString: +0.00% ; -0.00%
		displayFolder: 02. Time Intelligence
		lineageTag: e48bdfba-791b-4fc6-bc21-789a34bcda0a

