	partition 'Z_Header Fields' = calculated
		mode: import
		source = ```
				{
				    (FORMAT(LASTDATE(Dm_Date[Date]),"d-mmm-yy"), NAMEOF('DAX'[Avg Price Last Day]), 0),   
				    ("Daily $ Change", NAMEOF('DAX'[△Day]), 1),
				    ("Annual Change", NAMEOF('DAX'[Annual Change]),2),
				    ("52 Week Low", NAMEOF('DAX'[52 Week L]), 3),
				    ("52 Week High", NAMEOF('DAX'[52 Week H]), 4)
				}
				
				
				/*
				{
				    (FORMAT(LASTDATE(Dm_Date[Date]),"d-mmm-yy"), NAMEOF('DAX'[Avg Price Last Day]), 0),
				    (FORMAT([text_Previous date],"d-mmm-yy"), NAMEOF('DAX'[Avg Price Previous Day]), 1),
				    ("Diff", NAMEOF('DAX'[△Day]), 2),
				    (FORMAT(LASTDATE(Dm_Date[Date]),"mmm-yy"), NAMEOF('DAX'[Avg Price Last Month]), 3),
				    ((FORMAT(DATE(YEAR(LASTDATE(Dm_Date[Date]))-1,MONTH(LASTDATE(Dm_Date[Date])),1),"mmm-yy")), NAMEOF('DAX'[Avg Price Last Month LY]), 4),
				    ("%△Month", NAMEOF('DAX'[%△Month]), 5),
				    (YEAR(LASTDATE(Dm_Date[Date])), NAMEOF('DAX'[Avg Price This Year]), 6),
				    (YEAR(LASTDATE(Dm_Date[Date]))-1, NAMEOF('DAX'[Avg Price Last Year]), 7),
				    ("%△Year", NAMEOF('DAX'[%△Year]), 8)
				}
				*/
				```

