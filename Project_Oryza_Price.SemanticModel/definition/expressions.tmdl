expression Dim_all =
		let
		    Source = Table.Combine({#"2020", #"2021", #"2022", #"2023", #"2024", #"2025", #"2026"}),
		    #"Filtered Rows" = Table.SelectRows(Source, each [Category Name] <> null),
		    #"Capitalized Each Word" = Table.TransformColumns(#"Filtered Rows",{{"Country Name", Text.Proper, type text}}),
		    #"Added Custom" = Table.AddColumn(#"Capitalized Each Word", "Avg_Price", each ([Max Price]+[Min Price]) / 2),
		    #"Added Conditional Column" = Table.AddColumn(#"Added Custom", "New_Category Name", each if [Product Name] = "Thailand 25% broken" then "ข้าวขาว คุณภาพต่ำ" else if [Product Name] = "Vietnam 25% broken" then "ข้าวขาว คุณภาพต่ำ" else if [Product Name] = "Pakistan 25% broken" then "ข้าวขาว คุณภาพต่ำ" else if [Product Name] = "India 25% broken" then "ข้าวขาว คุณภาพต่ำ" else if [Product Name] = "U.S. 15% broken" then "ข้าวขาว คุณภาพต่ำ" else if [Category Name] = "ข้าวขาว" then "ข้าวขาว คุณภาพสูง" else [Category Name]),
		    #"Added Conditional Column1" = Table.AddColumn(#"Added Conditional Column", "New_Category Code", each if [New_Category Name] = "ข้าวขาว คุณภาพต่ำ" then "C000005" else [Category Code]),
		    #"Renamed Columns" = Table.RenameColumns(#"Added Conditional Column1",{{"Category Code", "Category Code Old"}, {"Category Name", "Category Name Old"}, {"New_Category Code", "Category Code"}, {"New_Category Name", "Category Name"}}),
		    #"Removed Other Columns" = Table.SelectColumns(#"Renamed Columns",{"HeaderDate", "SourceName", "Country Name", "Sub Category Code", "Product Code", "Avg_Price", "Category Code"}),
		    #"Reordered Columns" = Table.ReorderColumns(#"Removed Other Columns",{"HeaderDate", "Country Name", "Category Code", "Sub Category Code", "Product Code", "Avg_Price"}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns",{{"Avg_Price", type number}})
		in
		    #"Changed Type"
